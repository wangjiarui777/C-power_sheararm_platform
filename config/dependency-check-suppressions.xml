<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
        Dependency-Check matches the umbrella RuoYi CPE against each reactor
        module POM. These are project-level CPE records, not third-party jars.
        The affected endpoints have explicit permission checks and input/output
        hardening in this repository; keep this suppression narrow to those
        module POMs and the exact CPE so dependency findings remain actionable.
    -->
    <suppress until="2027-08-16">
        <notes><![CDATA[
            RuoYi umbrella CPE false positive on reactor module POMs. Re-review
            this suppression when upgrading the RuoYi baseline or changing the
            generator, notice, upload, or department security implementations.
        ]]></notes>
        <filePath regex="true">.*[/\\]ruoyi-(common|framework|generator|quartz|sensor|system)[/\\]pom\.xml$</filePath>
        <cpe>cpe:2.3:a:ruoyi:ruoyi:*:*:*:*:*:*:*:*</cpe>
    </suppress>
</suppressions>
