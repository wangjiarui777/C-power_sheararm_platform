# ===========================================
# RuoYi-Vue PHM 监测平台 — 环境变量配置
# ===========================================
# 复制此文件为 .env 并填入实际值
# 生产环境务必设置所有无默认值的变量

# --- 数据库 ---
MYSQL_PASSWORD=          # MySQL 数据库密码 (必填)
MYSQL_URL=jdbc:mysql://localhost:3306/ry-yue?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=GMT%2B8
MYSQL_USERNAME=root
# Windows 服务名；留空时按 MySQL80/MySQL96/MySQL/mysqld 依次探测
MYSQL_SERVICE_NAME=

# --- Redis ---
# 必须使用支持 Redis Streams 的 Redis 5+；Windows 推荐 Memurai 4+。
# 若本机 6379 已被旧版 Redis 占用，start-all.ps1 会在存在
# .local-data/redis8/**/redis-server.exe 时自动切换到 6380。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=          # Redis 密码 (生产必填)
# Windows 服务名；留空时按 Redis/Memurai 依次探测
REDIS_SERVICE_NAME=

# --- IoTDB 时序数据库 ---
IOTDB_HOME=C:\iotdb\apache-iotdb-2.0.8-all-bin  # IoTDB 2.0.x 安装根目录
IOTDB_PASSWORD=          # IoTDB 密码 (必填)
IOTDB_USERNAME=root
IOTDB_NODE_URLS=localhost:6667
IOTDB_DIAGNOSIS_TTL_DAYS=3650

# --- 首次启动 ---
INITIAL_ADMIN_PASSWORD=  # 仅首次生产启动读取；成功初始化后立即从环境移除

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:80,http://localhost:9528

# --- 采集器认证 ---
SENSOR_COLLECTOR_MASTER_KEY= # 每网关凭据的加密主密钥，至少32字节
SENSOR_COLLECTOR_TOKEN=      # 采集器实例专用令牌；不得复用主密钥

# --- 低代码独立数据库边界 ---
LOWCODE_DB_URL=              # 指向独立 schema，不得与 MYSQL_URL 相同
LOWCODE_DB_USERNAME=         # 只能访问低代码业务 schema
LOWCODE_DB_PASSWORD=         # 由凭据系统注入，至少16字节
LOWCODE_OUTBOUND_PROXY_HOST= # 强制出站代理；代理侧必须重复执行目标白名单/地址 ACL
LOWCODE_OUTBOUND_PROXY_PORT= # 1-65535

# --- WebSocket ---
SENSOR_WS_ALLOWED_ORIGINS=http://localhost:80,http://localhost:9528

# --- 推理服务 ---
SENSOR_DIAGNOSIS_REALTIME_PENDING_CLAIM_IDLE_MS=30000
SENSOR_DIAGNOSIS_REALTIME_PENDING_RECOVERY_MS=1000
# Java 平台访问的统一内部推理服务；浏览器不得直接访问
SENSOR_GEAR_INFER_URL=http://127.0.0.1:5001/internal/infer
SENSOR_BEARING_INFER_URL=http://127.0.0.1:5002/internal/infer
SENSOR_INFER_URL=http://127.0.0.1:5001/internal/infer
SENSOR_INFERENCE_INTERNAL_TOKEN= # Java 与内部推理服务之间的共享密钥，至少32字节
SENSOR_INFERENCE_REQUIRED=false
INFERENCE_BATCH_MAX_ITEMS=8
SENSOR_DIAGNOSIS_REALTIME_ENABLED=false
SENSOR_DIAGNOSIS_REALTIME_WINDOW_SAMPLES=5120
SENSOR_DIAGNOSIS_REALTIME_STRIDE_SAMPLES=5120
SENSOR_DIAGNOSIS_REALTIME_JOB_DEADLINE_SECONDS=10
SENSOR_DIAGNOSIS_REALTIME_MAX_ATTEMPTS=2
SENSOR_DIAGNOSIS_REALTIME_COALESCE_WINDOW_MS=150
SENSOR_DIAGNOSIS_REALTIME_COALESCE_BATCH_SIZE=8
SENSOR_DIAGNOSIS_REALTIME_MAX_BUFFER_SAMPLES=2000000
SENSOR_DIAGNOSIS_REALTIME_QUEUE_MAX_LENGTH=10000
SENSOR_DIAGNOSIS_REALTIME_DISPATCH_POLL_MS=250
GEAR_MODEL_VERSION=1.0.0
BEARING_MODEL_VERSION=1.0.0
SENSOR_DIAGNOSIS_AUTO_ALARM_ENABLED=false
SENSOR_DIAGNOSIS_READ_MODE=iotdb-primary
SENSOR_DIAGNOSIS_IOTDB_SYNC_POLL_DELAY_MS=5000
SENSOR_DIAGNOSIS_IOTDB_SYNC_BATCH_SIZE=100
SENSOR_DIAGNOSIS_IOTDB_SYNC_LEASE_SECONDS=60
SENSOR_ATTACHMENT_ROOT=D:/ruoyi-secure/attachments
# 目录结构：<接入根目录>/<设备编码>/*.mat|*.npy
SENSOR_DIAGNOSIS_INGEST_ENABLED=false
SENSOR_DIAGNOSIS_INGEST_ROOT=D:/ruoyi-secure/diagnosis-inbox
SENSOR_DIAGNOSIS_INGEST_SCAN_INTERVAL_MS=5000
SENSOR_DIAGNOSIS_INGEST_STABLE_WAIT_MS=10000
# 必须包含 SENSOR_ATTACHMENT_ROOT 下的 objects 目录
INFERENCE_ALLOWED_INPUT_ROOTS=D:/ruoyi-secure/attachments/objects
SENSOR_ATTACHMENT_SCAN_COMMAND=C:/Program Files/Windows Defender/MpCmdRun.exe
SENSOR_ATTACHMENT_SCAN_ARGUMENTS=-Scan,-ScanType,3,-File,{file},-DisableRemediation

# --- 文件与日志 ---
RUOYI_PROFILE=D:/ruoyi/data
LOG_PATH=D:/ruoyi/logs
REFERER_ALLOWED_DOMAINS=phm.example.internal

# --- XSS 过滤器 (生产环境建议启用) ---
XSS_ENABLED=false
SENSOR_DIAGNOSIS_MULTI_POINT_ENABLED=false
SENSOR_DIAGNOSIS_BATCH_MAX_POINTS=8
SENSOR_DIAGNOSIS_EXECUTOR_CORE_POOL_SIZE=4
