<service>
  <id>phm-platform</id>
  <name>PHM Java Platform</name>
  <description>RuoYi PHM API and WebSocket platform.</description>
  <executable>%BASE%\..\runtime\jre17\bin\java.exe</executable>
  <arguments>-Xms1g -Xmx4g -Dspring.profiles.active=prod -jar "%BASE%\..\current\backend\ruoyi-admin.jar"</arguments>
  <workingdirectory>%BASE%\..\current\backend</workingdirectory>
  <depend>phm-inference</depend>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="15 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>
  <logpath>%BASE%\..\logs\platform</logpath>
  <log mode="roll-by-size-time"><sizeThreshold>104857600</sizeThreshold><pattern>yyyyMMdd</pattern></log>
</service>
